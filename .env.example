# Supabase project values from the project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Canonical origin for this environment. Production uses the deployed GAP URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Put real values in ignored .env.local, never here. Never prefix with NEXT_PUBLIC_.
# Personal API token (not a Monday app client ID, client secret, or signing secret).
MONDAY_API_TOKEN=
MONDAY_ACCOUNT_ID=

# GAP members board; presence here means already accepted.
MONDAY_APPLICANTS_BOARD_ID=
# Preferred name. Legacy APPLICANTS alias may be left blank; never set conflicting IDs.
MONDAY_MEMBERS_BOARD_ID=
# Server-only Supabase secret key for private Monday and file-validation RPCs. Never expose publicly.
SUPABASE_SECRET_KEY=
MONDAY_EMAIL_COLUMN_ID=
MONDAY_ENROLL_IN_GAP_COLUMN_ID=
MONDAY_COHORT_COLUMN_ID=

# Membership status, NOT acceptance.
MONDAY_MEMBER_STATUS_COLUMN_ID=

# Progress reporting back to the same board.
MONDAY_REPORTING_BOARD_ID=
